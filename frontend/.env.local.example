# Copy to .env.local and adjust. Both are read at build time by Next.js.

# Backend base URL (uvicorn app.main:app --port 8000)
NEXT_PUBLIC_JAGSI_API=http://localhost:8000

# Device whose telemetry the dashboard shows. Must match DEVICE_ID in
# firmware/jagsi-watch/sketch.ino, or --device-id on tools/fake_device.py.
NEXT_PUBLIC_JAGSI_DEVICE_ID=jagsi-watch-01
