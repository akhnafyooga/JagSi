# Copy to backend/.env.demo (never commit that file; it is in .gitignore).
# docs/cloud-inference.md explains where each value comes from.

# Supabase > Connect > Session pooler. URL-encode the password.
# If the URI already has a query string, append &sslmode=require instead.
JAGSI_CLOUD_DSN=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# One UUID per local SQLite database. Keep it across restarts; make a new one
# only if backend/data/jagsi.db is deleted or replaced.
#   PowerShell: [guid]::NewGuid().ToString()     macOS/Linux: uuidgen
JAGSI_SOURCE_ID=PASTE_YOUR_GENERATED_UUID

JAGSI_DB_PATH=data/jagsi.db
JAGSI_DEVICE_ID=jagsi-watch-01
JAGSI_TOPIC_BASE=jagsi/abal/demo-TEAMTOKEN/v1/
JAGSI_MQTT_HOST=broker.hivemq.com
JAGSI_MQTT_PORT=1883
# Drop messages for any other device on the shared public broker.
JAGSI_RESTRICT_DEVICE=true
JAGSI_TREND_MODEL=demo/artifacts/trend_model.joblib
